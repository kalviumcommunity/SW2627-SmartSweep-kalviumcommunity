rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ------------------------------------------------
    // REPORTED ISSUES
    // ------------------------------------------------

    match /reported_issues/{issueId} {

      // A user can create a document only for themselves.
      allow create: if isSignedIn()
                    && request.resource.data.ownerId
                       == request.auth.uid;

      // Only the owner can read or delete
      // an existing document.
      allow read, delete: if isSignedIn()
                          && resource.data.ownerId
                             == request.auth.uid;

      // Only the owner can update the document,
      // and ownerId cannot be changed to another user.
      allow update: if isSignedIn()
                    && resource.data.ownerId
                       == request.auth.uid
                    && request.resource.data.ownerId
                       == request.auth.uid;
    }

    // ------------------------------------------------
    // CONNECTION TEST RECORDS
    // ------------------------------------------------

    match /connection_tests/{testId} {

      allow create: if isSignedIn()
                    && request.resource.data.ownerId
                       == request.auth.uid;

      allow read, delete: if isSignedIn()
                          && resource.data.ownerId
                             == request.auth.uid;

      allow update: if isSignedIn()
                    && resource.data.ownerId
                       == request.auth.uid
                    && request.resource.data.ownerId
                       == request.auth.uid;
    }

    // ------------------------------------------------
    // EVERYTHING ELSE IS BLOCKED
    // ------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}